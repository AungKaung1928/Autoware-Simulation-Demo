<?xml version="1.0"?>
<launch>
  <!-- Vehicle parameters -->
  <arg name="vehicle_id" default="ego_vehicle"/>
  <arg name="use_rviz" default="true"/>
  
  <!-- Robot State Publisher for URDF -->
  <node pkg="robot_state_publisher" exec="robot_state_publisher" name="robot_state_publisher" output="screen">
    <param name="robot_description" value="$(command 'xacro $(find-pkg-share autoware_sim_demo)/urdf/vehicle.urdf')"/>
  </node>
  
  <!-- Joint State Publisher (for wheel visualization) -->
  <node pkg="joint_state_publisher" exec="joint_state_publisher" name="joint_state_publisher">
    <param name="use_gui" value="false"/>
  </node>
  
  <!-- Main simulation node -->
  <node pkg="autoware_sim_demo" exec="autoware_sim_demo" name="autoware_sim_demo" output="screen">
    <param from="$(find-pkg-share autoware_sim_demo)/config/vehicle_info.param.yaml"/>
    <param from="$(find-pkg-share autoware_sim_demo)/config/sensor_kit.param.yaml"/>
  </node>
  
  <!-- RViz for visualization -->
  <node pkg="rviz2" exec="rviz2" name="rviz2" output="screen" if="$(var use_rviz)"/>
  
</launch>