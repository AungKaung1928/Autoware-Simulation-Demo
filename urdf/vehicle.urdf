      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="2.2 1.6 0.65"/>
      </geometry>
      <material name="modern_blue">
        <color rgba="0.15 0.35 0.65 1.0"/>
      </material>
    </visual>
  </link>
  
  <joint name="base_to_cabin" type="fixed">
    <parent link="base_link"/>
    <child link="cabin"/>
    <origin xyz="0.1 0 0.83" rpy="0 0 0"/>
  </joint>

  <link name="rear_window">
    <visual>
      <origin xyz="0 0 0" rpy="0 -0.3 0"/>
      <geometry>
        <box size="0.5 1.5 0.05"/>
      </geometry>
      <material name="glass">
        <color rgba="0.3 0.4 0.5 0.6"/>
      </material>
    </visual>
  </link>
  
  <joint name="base_to_rear_window" type="fixed">
    <parent link="base_link"/>
    <child link="rear_window"/>
    <origin xyz="-0.95 0 0.85" rpy="0 0 0"/>
  </joint>

  <link name="trunk">
    <visual>
      <origin xyz="0 0 0" rpy="0 -0.05 0"/>
      <geometry>
        <box size="0.9 1.7 0.3"/>
      </geometry>
      <material name="modern_blue">
        <color rgba="0.15 0.35 0.65 1.0"/>
