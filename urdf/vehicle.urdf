  <link name="mirror_right">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.12 0.08 0.15"/>
      </geometry>
      <material name="modern_blue">
        <color rgba="0.15 0.35 0.65 1.0"/>
      </material>
    </visual>
