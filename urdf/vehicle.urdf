<?xml version="1.0"?>
<robot name="autoware_vehicle">
  
  <link name="base_link">
    <visual>
      <origin xyz="0.3 0 0.35" rpy="0 0 0"/>
      <geometry>
        <box size="3.8 1.7 0.6"/>
      </geometry>
      <material name="modern_blue">
        <color rgba="0.15 0.35 0.65 1.0"/>
      </material>
    </visual>
  </link>

  <link name="hood">
    <visual>
      <origin xyz="0 0 0" rpy="0 0.1 0"/>
      <geometry>
        <box size="1.2 1.7 0.15"/>
      </geometry>
      <material name="modern_blue">
        <color rgba="0.15 0.35 0.65 1.0"/>
      </material>
    </visual>
  </link>
  
  <joint name="base_to_hood" type="fixed">
    <parent link="base_link"/>
    <child link="hood"/>
    <origin xyz="1.9 0 0.42" rpy="0 0 0"/>
  </joint>

  <link name="windshield">
    <visual>
      <origin xyz="0 0 0" rpy="0 0.4 0"/>
      <geometry>
        <box size="0.6 1.5 0.05"/>
      </geometry>
      <material name="glass">
        <color rgba="0.3 0.4 0.5 0.6"/>
      </material>
    </visual>
  </link>
  
  <joint name="base_to_windshield" type="fixed">
    <parent link="base_link"/>
    <child link="windshield"/>
    <origin xyz="0.95 0 0.75" rpy="0 0 0"/>
  </joint>

  <link name="cabin">
