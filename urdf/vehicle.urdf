      </geometry>
      <material name="white">
        <color rgba="0.95 0.95 0.85 1.0"/>
      </material>
    </visual>
  </link>
  
  <joint name="base_to_headlight_right" type="fixed">
    <parent link="base_link"/>
    <child link="headlight_right"/>
