    </visual>
  </link>
  
  <joint name="base_to_headlight_left" type="fixed">
    <parent link="base_link"/>
    <child link="headlight_left"/>
    <origin xyz="2.28 0.55 0.35" rpy="0 0 0"/>
  </joint>

  <link name="headlight_right">
