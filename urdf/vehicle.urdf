        <box size="0.08 1.4 0.25"/>
      </geometry>
      <material name="dark_gray">
        <color rgba="0.15 0.15 0.15 1.0"/>
      </material>
    </visual>
  </link>
  
  <joint name="base_to_grille" type="fixed">
