    </visual>
  </link>
  
  <joint name="rear_right_wheel_joint" type="continuous">
    <parent link="base_link"/>
    <child link="rear_right_wheel"/>
    <origin xyz="-1.05 -0.88 0.32" rpy="0 0 0"/>
    <axis xyz="0 1 0"/>
